# PromptKit 邮件配置
# QQ邮箱 SMTP 默认值如下，无需修改
# smtp_host=smtp.qq.com
# smtp_port=465
# smtp_ssl=true

# 发件人邮箱（你的QQ邮箱）
sender_email=你的QQ号@qq.com

# 发件人名称（显示在邮件里）
sender_name=PromptKit Dev Bot

# SMTP授权码（不是QQ密码！）
# 获取方式：QQ邮箱 → 设置 → 账户 → POP3/IMAP/SMTP服务 → 开启 → 生成授权码
sender_auth_code=你的16位授权码

# 收件人邮箱
recipient_email=你的QQ号@qq.com

# 收件人名称
recipient_name=ASUS
